    "Off: reminders follow the clock where you are, so an 8:00 dose comes at 8:00 local time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقف: تتبع التذكيرات الساعة حيث أنت، فجرعة 8:00 تصل الساعة 8:00 بالتوقيت المحلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Erinnerungen folgen der Uhr am Aufenthaltsort, eine 8:00-Dosis kommt also um 8:00 Ortszeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: los recordatorios siguen la hora del lugar donde estés, así que una dosis de las 8:00 llega a las 8:00 hora local."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: los recordatorios siguen la hora del lugar donde estés, así que una dosis de las 8:00 llega a las 8:00 hora local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : les rappels suivent l’heure du lieu où vous êtes, une dose de 8:00 arrive donc à 8:00 heure locale."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : les rappels suivent l’heure du lieu où vous êtes, une dose de 8:00 arrive donc à 8:00 heure locale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद: रिमाइंडर आपकी जगह की घड़ी के हिसाब से चलते हैं, तो 8:00 की खुराक स्थानीय समय 8:00 बजे आएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktif: pengingat mengikuti jam di tempatmu berada, jadi dosis pukul 8:00 datang pukul 8:00 waktu setempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: i promemoria seguono l’ora del luogo in cui ti trovi, quindi una dose delle 8:00 arriva alle 8:00 ora locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ：リマインダーは現在地の時刻に従うため、8:00の服用は現地時間の8:00に届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔: 알림이 현재 위치의 시계를 따르므로 8:00 복용은 현지 시간 8:00에 옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: os lembretes seguem o relógio de onde você está, então uma dose das 8:00 chega às 8:00 no horário local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл.: напоминания идут по часам того места, где вы находитесь, — доза в 8:00 придёт в 8:00 по местному времени."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı: hatırlatmalar bulunduğun yerin saatini izler, yani saat 8:00’deki doz yerel saatle 8:00’de gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭：提醒按你所在地的时钟发送，因此 8:00 的剂量会在当地时间 8:00 提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉：提醒按你所在地的時鐘發送，因此 8:00 的劑量會在當地時間 8:00 提醒。"
          }
        }
      }
    },
