    "Lowest first, so what needs attention is on top." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأقل أولاً، ليكون ما يحتاج إلى انتباه في الأعلى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrigste zuerst, damit oben steht, was Aufmerksamkeit braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De menor a mayor, para tener arriba lo que necesita atención."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De menor a mayor, para tener arriba lo que necesita atención."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus bas d’abord, pour voir en haut ce qui demande de l’attention."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus bas d’abord, pour voir en haut ce qui demande de l’attention."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे कम पहले, ताकि जिस पर ध्यान चाहिए वह ऊपर रहे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terendah dulu, agar yang perlu perhatian ada di atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dal più basso, così ciò che richiede attenzione è in cima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少ない順。注意が必要なものが上に来ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮은 순으로, 주의가 필요한 것이 위에 옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do menor para o maior, para o que precisa de atenção ficar no topo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала самые низкие — то, что требует внимания, наверху."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En düşük önce, ilgi gerektiren en üstte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从低到高，需要关注的排在最上面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從低到高，需要關注的排在最上面。"
          }
        }
      }
    },
