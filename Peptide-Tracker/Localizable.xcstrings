          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous décomptons à partir d’ici et vous prévenons avant d’être à court."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम यहाँ से उल्टी गिनती करते हैं और ख़त्म होने से पहले आपको बताते हैं।"
