    "Plans every reminder again from scratch. Handy after travelling or changing the time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد جدولة كل تذكير من البداية. مفيد بعد السفر أو تغيير الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plant jede Erinnerung neu. Praktisch nach Reisen oder einer Zeitumstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a programar todos los recordatorios desde cero. Útil tras viajar o cambiar la hora."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a programar todos los recordatorios desde cero. Útil tras viajar o cambiar la hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replanifie chaque rappel depuis zéro. Pratique après un voyage ou un changement d’heure."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replanifie chaque rappel depuis zéro. Pratique après un voyage ou un changement d’heure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर रिमाइंडर नए सिरे से तय करता है। यात्रा या समय बदलने के बाद काम का।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjadwalkan ulang semua pengingat dari awal. Berguna setelah bepergian atau mengubah waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprogramma tutti i promemoria da zero. Utile dopo un viaggio o un cambio d’ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのリマインダーを最初から計画し直します。旅行後や時刻変更後に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 알림을 처음부터 다시 예약합니다. 여행이나 시간 변경 후 유용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprograma todos os lembretes do zero. Útil após viajar ou mudar o horário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заново планирует все напоминания. Удобно после поездки или смены времени."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her hatırlatmayı baştan planlar. Seyahatten veya saat değişikliğinden sonra kullanışlı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
