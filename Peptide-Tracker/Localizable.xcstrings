          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведём отсчёт отсюда и предупредим заранее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buradan geri sayar ve bitmeden önce seni uyarırız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们从这里开始倒数，并在用完前提醒你。"
