          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर खुराक, दवा, रिफ़िल, मूड और वज़न को Numbers, Excel या Google Sheets के लिए स्प्रेडशीट के रूप में डाउनलोड करें।"
