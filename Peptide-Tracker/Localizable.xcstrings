    "Write {medicine} where the medicine’s name should go. Leave it empty for “Tap to refill.”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب {medicine} حيث يجب أن يظهر اسم الدواء. اتركه فارغاً لـ «اضغط لإعادة الصرف.»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib {medicine}, wo der Name des Medikaments stehen soll. Leer lassen für „Zum Nachfüllen tippen.“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe {medicine} donde deba ir el nombre del medicamento. Déjalo vacío para «Toca para reponer.»"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe {medicine} donde deba ir el nombre del medicamento. Déjalo vacío para «Toca para reponer.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez {medicine} là où le nom du médicament doit apparaître. Laissez vide pour « Touchez pour renouveler. »"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez {medicine} là où le nom du médicament doit apparaître. Laissez vide pour « Touchez pour renouveler. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहाँ दवा का नाम आना चाहिए वहाँ {medicine} लिखें। “रिफ़िल के लिए टैप करें।” के लिए ख़ाली छोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis {medicine} di tempat nama obat harus muncul. Biarkan kosong untuk “Ketuk untuk isi ulang.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
