    "One reminder a few days before each medicine runs out, at the time you picked. Nothing else." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكير واحد قبل نفاد كل دواء ببضعة أيام، في الوقت الذي اخترته. لا شيء غير ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Erinnerung ein paar Tage, bevor ein Medikament aufgebraucht ist, zur gewählten Uhrzeit. Sonst nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio unos días antes de que se acabe cada medicamento, a la hora que elegiste. Nada más."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio unos días antes de que se acabe cada medicamento, a la hora que elegiste. Nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel quelques jours avant l’épuisement de chaque médicament, à l’heure choisie. Rien d’autre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel quelques jours avant l’épuisement de chaque médicament, à l’heure choisie. Rien d’autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दवा के ख़त्म होने से कुछ दिन पहले, आपके चुने समय पर एक रिमाइंडर। बस इतना ही।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu pengingat beberapa hari sebelum setiap obat habis, pada waktu yang kamu pilih. Tidak lebih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un promemoria qualche giorno prima che finisca ogni farmaco, all’ora scelta. Nient’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薬がなくなる数日前に、選んだ時刻に1回お知らせします。それだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약이 떨어지기 며칠 전, 선택한 시간에 한 번 알려 드립니다. 그 외에는 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um lembrete alguns dias antes de cada remédio acabar, no horário que você escolheu. Nada mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно напоминание за несколько дней до окончания каждого лекарства, в выбранное время. И всё."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ilaç bitmeden birkaç gün önce seçtiğin saatte bir hatırlatma. Başka bir şey yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每种药物用完前几天，在你选定的时间提醒一次。仅此而已。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每種藥物用完前幾天，在你選定的時間提醒一次。僅此而已。"
          }
        }
      }
    },
