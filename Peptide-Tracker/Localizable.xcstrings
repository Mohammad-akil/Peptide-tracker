    "%@ is a personal log and reminder. It doesn’t give medical advice or recommend doses. Always follow your doctor’s or pharmacist’s instructions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ سجل شخصي وتذكيرات. لا يقدّم نصائح طبية ولا يوصي بجرعات. اتبع دائماً تعليمات طبيبك أو الصيدلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein persönliches Protokoll mit Erinnerungen. Es gibt keine medizinischen Ratschläge und empfiehlt keine Dosen. Folge immer den Anweisungen deines Arztes oder Apothekers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un registro personal con recordatorios. No da consejos médicos ni recomienda dosis. Sigue siempre las indicaciones de tu médico o farmacéutico."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un registro personal con recordatorios. No da consejos médicos ni recomienda dosis. Sigue siempre las indicaciones de tu médico o farmacéutico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un journal personnel avec rappels. Il ne donne pas d’avis médical et ne recommande pas de doses. Suivez toujours les instructions de votre médecin ou pharmacien."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un journal personnel avec rappels. Il ne donne pas d’avis médical et ne recommande pas de doses. Suivez toujours les instructions de votre médecin ou pharmacien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ एक निजी लॉग और रिमाइंडर है। यह चिकित्सा सलाह नहीं देता और न ही खुराक सुझाता है। हमेशा अपने डॉक्टर या फ़ार्मासिस्ट के निर्देश मानें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah catatan pribadi dan pengingat. Tidak memberikan saran medis atau merekomendasikan dosis. Selalu ikuti petunjuk dokter atau apoteker."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un diario personale con promemoria. Non fornisce consigli medici né raccomanda dosi. Segui sempre le indicazioni del tuo medico o farmacista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は個人用の記録とリマインダーです。医学的な助言や用量の推奨は行いません。必ず医師または薬剤師の指示に従ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 개인 기록 및 알림 앱입니다. 의학적 조언이나 용량 추천을 하지 않습니다. 항상 의사나 약사의 지시를 따르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é um registro pessoal com lembretes. Ele não dá conselhos médicos nem recomenda doses. Siga sempre as orientações do seu médico ou farmacêutico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — личный журнал с напоминаниями. Он не даёт медицинских советов и не рекомендует дозы. Всегда следуйте указаниям врача или фармацевта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kişisel bir kayıt ve hatırlatma uygulamasıdır. Tıbbi tavsiye vermez veya doz önermez. Her zaman doktorunun veya eczacının talimatlarına uy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是个人记录与提醒工具，不提供医疗建议，也不推荐剂量。请始终遵循医生或药剂师的指导。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是個人記錄與提醒工具，不提供醫療建議，也不推薦劑量。請始終遵循醫生或藥劑師的指導。"
          }
        }
      }
    },
