    "Tell us what you have and how much you take. We’ll remind you early enough to refill." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرنا بما لديك وكم تتناول. سنذكّرك مبكراً بما يكفي لإعادة الصرف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag uns, was du hast und wie viel du nimmst. Wir erinnern dich früh genug ans Nachfüllen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos qué tienes y cuánto tomas. Te avisaremos con tiempo para reponer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos qué tienes y cuánto tomas. Te avisaremos con tiempo para reponer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-nous ce que vous avez et ce que vous prenez. Nous vous préviendrons assez tôt pour renouveler."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-nous ce que vous avez et ce que vous prenez. Nous vous préviendrons assez tôt pour renouveler."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बताएँ आपके पास क्या है और कितना लेते हैं। हम रिफ़िल के लिए समय रहते याद दिलाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri tahu kami apa yang kamu punya dan berapa yang kamu minum. Kami akan mengingatkanmu cukup awal untuk isi ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicci cosa hai e quanto ne prendi. Ti ricorderemo in tempo di riordinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手元の量と使う量を教えてください。補充に間に合うようにお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보유량과 사용량을 알려 주세요. 보충할 수 있도록 미리 알려 드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte o que você tem e quanto usa. Vamos lembrar você a tempo de repor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расскажите, что у вас есть и сколько вы принимаете. Мы напомним заранее, чтобы успеть пополнить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elinde ne olduğunu ve ne kadar aldığını söyle. Yenilemek için yeterince erken hatırlatalım."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我们你有什么以及用量，我们会及早提醒你续药。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴我們你有什麼以及用量，我們會及早提醒你續藥。"
          }
        }
      }
    },
