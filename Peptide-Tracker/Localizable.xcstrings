    "Any doses left for today? Tick them off so your count stays right." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل بقيت جرعات لليوم؟ ضع علامة عليها ليبقى العدد صحيحاً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch Dosen für heute übrig? Hake sie ab, damit dein Bestand stimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te quedan dosis hoy? Márcalas para que tu recuento sea correcto."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te quedan dosis hoy? Márcalas para que tu recuento sea correcto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des doses restantes aujourd’hui ? Cochez-les pour garder un compte exact."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des doses restantes aujourd’hui ? Cochez-les pour garder un compte exact."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज की कोई खुराक बाकी है? उन्हें टिक करें ताकि गिनती सही रहे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih ada dosis hari ini? Centang agar hitunganmu tetap tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti restano dosi per oggi? Spuntale per mantenere il conteggio giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の残りの服用はありますか？ チェックして数を正しく保ちましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 남은 복용이 있나요? 체크해서 수량을 정확하게 유지하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restam doses hoje? Marque-as para manter a contagem certa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остались дозы на сегодня? Отметьте их, чтобы счёт был точным."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün kalan doz var mı? Sayının doğru kalması için işaretle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天还有剂量吗？勾选它们，让计数保持准确。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天還有劑量嗎？勾選它們，讓計數保持準確。"
          }
        }
      }
    },
