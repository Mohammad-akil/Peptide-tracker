    "Count millilitres. A 150 ml bottle at 5 ml a dose is 150 ml." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احسب بالمليلتر. زجاجة 150 مل بجرعة 5 مل تساوي 150 مل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähle Milliliter. Eine 150-ml-Flasche bei 5 ml pro Dosis sind 150 ml."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta mililitros. Un frasco de 150 ml a 5 ml por dosis son 150 ml."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta mililitros. Un frasco de 150 ml a 5 ml por dosis son 150 ml."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez en millilitres. Un flacon de 150 ml à 5 ml par dose fait 150 ml."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez en millilitres. Un flacon de 150 ml à 5 ml par dose fait 150 ml."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलीलीटर गिनें। 5 मिली प्रति खुराक वाली 150 मिली की बोतल यानी 150 मिली।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitung mililiter. Botol 150 ml dengan 5 ml per dosis berarti 150 ml."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta i millilitri. Un flacone da 150 ml a 5 ml per dose fa 150 ml."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミリリットルで数えます。1回5 mlで150 mlのボトルなら150 mlです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밀리리터로 셉니다. 1회 5 ml인 150 ml 병은 150 ml입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte mililitros. Um frasco de 150 ml com 5 ml por dose são 150 ml."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считайте в миллилитрах. Флакон 150 мл по 5 мл на дозу — это 150 мл."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mililitre say. Doz başına 5 ml ile 150 ml’lik bir şişe 150 ml’dir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按毫升计算。每剂 5 毫升的 150 毫升瓶装即为 150 毫升。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按毫升計算。每劑 5 毫升的 150 毫升瓶裝即為 150 毫升。"
          }
        }
      }
    },
    "Count puffs. Most inhalers show how many are left on a counter." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احسب البخّات. تعرض معظم البخاخات العدد المتبقي على عدّاد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähle Hübe. Die meisten Inhalatoren zeigen auf einem Zähler, wie viele übrig sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta pulsaciones. La mayoría de inhaladores muestran en un contador cuántas quedan."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta pulsaciones. La mayoría de inhaladores muestran en un contador cuántas quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez les bouffées. La plupart des inhalateurs affichent le nombre restant sur un compteur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez les bouffées. La plupart des inhalateurs affichent le nombre restant sur un compteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पफ़ गिनें। ज़्यादातर इनहेलर काउंटर पर बचे हुए पफ़ दिखाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitung semprotan. Kebanyakan inhaler menunjukkan sisanya di penghitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta gli spruzzi. La maggior parte degli inalatori mostra quanti ne restano su un contatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "噴霧回数で数えます。多くの吸入器はカウンターで残数を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분사 횟수로 셉니다. 대부분의 흡입기는 카운터에 남은 횟수를 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte jatos. A maioria dos inaladores mostra quantos restam num contador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считайте впрыски. Большинство ингаляторов показывают остаток на счётчике."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Püskürtme say. Çoğu inhaler kalan sayıyı bir sayaçta gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按喷数计算。大多数吸入器会在计数器上显示剩余次数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按噴數計算。大多數吸入器會在計數器上顯示剩餘次數。"
          }
        }
      }
    },
    "Count single doses. A pen with 300 units at 15 units a dose is 20 doses." : {
      "localizations" : {
