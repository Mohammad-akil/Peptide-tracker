    "Asks for %@ when %@ opens, and hides it in the app switcher." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب %1$@ عند فتح %2$@ ويخفيه في مبدّل التطبيقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt nach %1$@, wenn %2$@ geöffnet wird, und verbirgt die App im App-Umschalter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Asks for %1$@ when %2$@ opens, and hides it in the app switcher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide %1$@ al abrir %2$@ y oculta la app en el selector de apps."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide %1$@ al abrir %2$@ y oculta la app en el selector de apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande %1$@ à l’ouverture de %2$@ et masque l’app dans le sélecteur d’apps."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande %1$@ à l’ouverture de %2$@ et masque l’app dans le sélecteur d’apps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ खुलने पर %1$@ माँगता है, और ऐप स्विचर में उसे छिपाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meminta %1$@ saat %2$@ dibuka, dan menyembunyikannya di pengalih app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede %1$@ all’apertura di %2$@ e la nasconde nel selettore app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@を開くときに%1$@を求め、Appスイッチャーで内容を隠します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@을(를) 열 때 %1$@을(를) 요청하고 앱 전환기에서 내용을 숨깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede %1$@ ao abrir o %2$@ e oculta o app no seletor de apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрашивает %1$@ при открытии %2$@ и скрывает содержимое в переключателе приложений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ açılırken %1$@ ister ve uygulama değiştiricide gizler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 %2$@ 时要求%1$@，并在 App 切换器中隐藏内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開 %2$@ 時要求%1$@，並在 App 切換器中隱藏內容。"
          }
        }
      }
    },
