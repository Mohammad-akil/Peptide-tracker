        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli come appare %@ nella schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面での%@の見た目を選択。"
          }
        },
        "ko" : {
          "stringUnit" : {
