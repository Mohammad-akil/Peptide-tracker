        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりにスケジュールからカウントダウンし、「今日」にはチェックする服用が表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대신 일정에 따라 차감하며, 오늘 화면에 체크할 복용이 표시되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em vez disso, descontamos pelo seu esquema, e Hoje não mostra doses para marcar."
