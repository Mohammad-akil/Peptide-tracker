    "Illustration: with Doseday, weight steadily reaches your goal. Without an app, it stalls and drifts back up." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توضيح: مع Doseday يصل الوزن بثبات إلى هدفك. دون تطبيق يتوقف ثم يعود للارتفاع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
