        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat beberapa efek samping dan pola akan muncul di sini — seperti hari keberapa setelah dosis biasanya muncul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra qualche effetto collaterale e qui compariranno degli schemi, come in quale giorno dopo una dose tendono a presentarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "副作用をいくつか記録すると、ここにパターンが表示されます。たとえば服用後何日目に出やすいかなど。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부작용을 몇 번 기록하면 여기에 패턴이 표시됩니다. 예를 들어 복용 후 며칠째에 주로 나타나는지 등."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre alguns efeitos colaterais e os padrões aparecem aqui — como em que dia após a dose eles costumam surgir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте несколько побочных эффектов, и здесь появятся закономерности — например, на какой день после дозы они обычно возникают."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç yan etki kaydet, burada örüntüler görünsün — örneğin dozdan sonraki hangi gün ortaya çıktıkları."
