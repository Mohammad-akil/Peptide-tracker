    "If any, let us know so we can customize your experience. Choose all that apply." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن وجدت، أخبرنا لنخصص تجربتك. اختر كل ما ينطبق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls ja, sag es uns, damit wir die App anpassen können. Wähle alles Zutreffende."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If any, let us know so we can customise your experience. Choose all that apply."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If any, let us know so we can customise your experience. Choose all that apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si es así, cuéntanoslo para personalizar tu experiencia. Elige todo lo que corresponda."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si es así, cuéntanoslo para personalizar tu experiencia. Elige todo lo que corresponda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cas échéant, dites-le-nous pour personnaliser votre expérience. Choisissez tout ce qui s’applique."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cas échéant, dites-le-nous pour personnaliser votre expérience. Choisissez tout ce qui s’applique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर कोई हो, तो बताएँ ताकि हम आपका अनुभव अनुकूल बना सकें। जो भी लागू हो, सब चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ada, beri tahu kami agar kami bisa menyesuaikan pengalamanmu. Pilih semua yang sesuai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ce ne sono, diccelo per personalizzare l’esperienza. Scegli tutto ciò che vale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あれば教えてください。体験を調整します。当てはまるものをすべて選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "있다면 알려 주세요. 경험을 맞춤 설정할게요. 해당하는 것을 모두 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se houver, conte para personalizarmos sua experiência. Escolha tudo o que se aplica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если есть, расскажите — мы настроим приложение. Выберите всё подходящее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsa bize söyle, deneyimini kişiselleştirelim. Uyanların hepsini seç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果有，请告诉我们以便为你定制体验。选择所有适用项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果有，請告訴我們以便為你定制體驗。選擇所有適用項。"
          }
        }
      }
    },
    "If it’s not listed, choose Other." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن لم يكن مدرجاً، اختر «آخر»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es nicht aufgeführt ist, wähle „Andere“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no aparece, elige Otro."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no aparece, elige Otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’il n’est pas listé, choisissez Autre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’il n’est pas listé, choisissez Autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर सूची में नहीं है, तो “अन्य” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tidak ada di daftar, pilih Lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non è in elenco, scegli Altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覧にない場合は「その他」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록에 없으면 기타를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não estiver na lista, escolha Outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если нет в списке, выберите «Другое»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listede yoksa Diğer’i seç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果未列出，请选择“其他”。"
          }
