    "Each day fills in purple as you tick off doses. Tap a month to see it up close." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمتلئ كل يوم باللون البنفسجي عند وضع علامة على الجرعات. اضغط على شهر لرؤيته عن قرب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tag füllt sich lila, wenn du Dosen abhakst. Tippe auf einen Monat, um ihn genauer zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día se rellena de morado al marcar dosis. Toca un mes para verlo de cerca."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día se rellena de morado al marcar dosis. Toca un mes para verlo de cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour se remplit de violet quand vous cochez vos doses. Touchez un mois pour le voir de près."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour se remplit de violet quand vous cochez vos doses. Touchez un mois pour le voir de près."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुराकें टिक करते ही हर दिन बैंगनी हो जाता है। पास से देखने के लिए किसी महीने पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap hari terisi ungu saat kamu mencentang dosis. Ketuk bulan untuk melihatnya lebih dekat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno si colora di viola man mano che spunti le dosi. Tocca un mese per vederlo da vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服用をチェックすると、その日が紫色に塗られます。月をタップすると拡大表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복용을 체크하면 그날이 보라색으로 채워집니다. 월을 탭하면 크게 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dia fica roxo conforme você marca as doses. Toque em um mês para vê-lo de perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дни окрашиваются фиолетовым по мере отметки доз. Коснитесь месяца, чтобы рассмотреть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozları işaretledikçe her gün mora boyanır. Yakından görmek için bir aya dokun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选剂量后，每天会填充为紫色。轻点月份可放大查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾選劑量後，每天會填充為紫色。輕點月份可放大查看。"
          }
        }
      }
    },
