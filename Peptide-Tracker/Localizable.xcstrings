    "Weight change with and without the app, for illustration only. Results vary from person to person." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغير الوزن مع التطبيق ودونه، للتوضيح فقط. تختلف النتائج من شخص لآخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewichtsveränderung mit und ohne App, nur zur Veranschaulichung. Ergebnisse sind individuell verschieden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio de peso con y sin la app, solo ilustrativo. Los resultados varían de una persona a otra."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio de peso con y sin la app, solo ilustrativo. Los resultados varían de una persona a otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variation de poids avec et sans l’app, à titre d’illustration. Les résultats varient d’une personne à l’autre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variation de poids avec et sans l’app, à titre d’illustration. Les résultats varient d’une personne à l’autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के साथ और बिना ऐप के वज़न में बदलाव, सिर्फ़ उदाहरण के लिए। नतीजे हर व्यक्ति में अलग होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan berat dengan dan tanpa app, hanya ilustrasi. Hasil berbeda pada setiap orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variazione di peso con e senza l’app, solo a scopo illustrativo. I risultati variano da persona a persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリあり・なしの体重変化（イメージです）。結果には個人差があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 사용 여부에 따른 체중 변화 예시입니다. 결과는 사람마다 다릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variação de peso com e sem o app, apenas ilustrativa. Os resultados variam de pessoa para pessoa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменение веса с приложением и без, только для иллюстрации. Результаты индивидуальны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayla ve uygulama olmadan kilo değişimi, yalnızca örnek amaçlı. Sonuçlar kişiden kişiye değişir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用与不使用 App 的体重变化，仅为示意。结果因人而异。"
