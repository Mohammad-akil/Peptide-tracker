    "Deletes every medicine, dose, refill, contact and setting on this iPhone. You can’t undo this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف كل الأدوية والجرعات وعمليات إعادة الصرف وجهات الاتصال والإعدادات على هذا الـ iPhone. لا يمكن التراجع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle Medikamente, Dosen, Nachfüllungen, Kontakte und Einstellungen auf diesem iPhone. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los medicamentos, dosis, reposiciones, contactos y ajustes de este iPhone. No se puede deshacer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los medicamentos, dosis, reposiciones, contactos y ajustes de este iPhone. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tous les médicaments, doses, renouvellements, contacts et réglages de cet iPhone. Action irréversible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tous les médicaments, doses, renouvellements, contacts et réglages de cet iPhone. Action irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone की हर दवा, खुराक, रिफ़िल, संपर्क और सेटिंग हटाता है। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus semua obat, dosis, isi ulang, kontak, dan pengaturan di iPhone ini. Tidak bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina ogni farmaco, dose, riordino, contatto e impostazione su questo iPhone. Non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhone上のすべての薬、服用、補充、連絡先、設定を削除します。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone의 모든 약, 복용, 보충, 연락처, 설정을 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todos os remédios, doses, reposições, contatos e ajustes deste iPhone. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все лекарства, дозы, пополнения, контакты и настройки на этом iPhone. Отменить нельзя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone’daki tüm ilaçları, dozları, yenilemeleri, kişileri ve ayarları siler. Geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除此 iPhone 上的所有药物、剂量、续药、联系人和设置。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除此 iPhone 上的所有藥物、劑量、續藥、聯絡人和設定。此操作無法撤銷。"
          }
        }
      }
    },
    "Deleting the app deletes everything it saved." : {
      "localizations" : {
