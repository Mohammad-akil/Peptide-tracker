    "Doseday suggests the site that has rested longest, in the areas you use. Turn off any you don’t inject." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقترح Doseday الموضع الذي استراح أطول مدة ضمن المناطق التي تستخدمها. أوقف أي منطقة لا تحقن فيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday schlägt die Stelle vor, die sich am längsten erholt hat, in den Bereichen, die du nutzt. Schalte alle aus, in die du nicht spritzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday sugiere la zona que más tiempo ha descansado entre las que usas. Desactiva las que no uses para inyectarte."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday sugiere la zona que más tiempo ha descansado entre las que usas. Desactiva las que no uses para inyectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday suggère le site qui s’est reposé le plus longtemps parmi ceux que vous utilisez. Désactivez ceux où vous n’injectez pas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday suggère le site qui s’est reposé le plus longtemps parmi ceux que vous utilisez. Désactivez ceux où vous n’injectez pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday आपके इस्तेमाल वाले हिस्सों में से सबसे लंबे समय से आराम कर रही जगह सुझाता है। जहाँ इंजेक्शन नहीं लगाते, उन्हें बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday menyarankan lokasi yang paling lama beristirahat di area yang kamu gunakan. Nonaktifkan yang tidak kamu suntik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday suggerisce il sito che ha riposato più a lungo, nelle zone che usi. Disattiva quelle dove non fai iniezioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosedayは、使う部位の中でいちばん長く休ませた部位を提案します。注射しない部位はオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday는 사용하는 부위 중 가장 오래 쉰 부위를 추천합니다. 주사하지 않는 부위는 끄세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Doseday sugere o local que descansou por mais tempo, nas áreas que você usa. Desative as que você não usa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday предлагает место, которое дольше всех отдыхало, среди используемых зон. Отключите те, куда вы не делаете уколы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday, kullandığın bölgeler arasında en uzun süre dinlenmiş olanı önerir. Enjeksiyon yapmadığın bölgeleri kapat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday 会在你使用的部位中推荐休息时间最长的部位。关闭你不注射的部位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
