        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們從這裡開始倒數，並在用完前提醒你。"
          }
        }
      }
    },
    "We count down from your schedule instead, and Today shows no doses to tick." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدلاً من ذلك نعدّ تنازلياً من جدولك، ولا يعرض «اليوم» جرعات لوضع علامة عليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stattdessen zählen wir nach deinem Plan herunter, und „Heute“ zeigt keine Dosen zum Abhaken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En su lugar descontamos según tu pauta, y Hoy no muestra dosis para marcar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En su lugar descontamos según tu pauta, y Hoy no muestra dosis para marcar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous décomptons alors selon votre calendrier, et Aujourd’hui n’affiche aucune dose à cocher."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous décomptons alors selon votre calendrier, et Aujourd’hui n’affiche aucune dose à cocher."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके बजाय हम आपके शेड्यूल से गिनती घटाते हैं, और आज स्क्रीन पर टिक करने को कोई खुराक नहीं दिखती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebagai gantinya kami menghitung mundur dari jadwalmu, dan Hari ini tidak menampilkan dosis untuk dicentang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaliamo invece in base al programma, e Oggi non mostra dosi da spuntare."
