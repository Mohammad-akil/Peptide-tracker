          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके रिफ़िल में असल में लगने वाले समय के हिसाब से रिमाइंडर, ताकि दवा कभी ख़त्म न हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
