    "Notifications are off for this app in iOS Settings, so reminders can’t arrive." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعارات هذا التطبيق متوقفة في إعدادات iOS، لذا لا يمكن أن تصل التذكيرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen für diese App sind in den iOS-Einstellungen aus, daher können keine Erinnerungen ankommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de esta app están desactivadas en los Ajustes de iOS, así que no pueden llegar recordatorios."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de esta app están desactivadas en los Configuración de iOS, así que no pueden llegar recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications de cette app sont désactivées dans les Réglages iOS, les rappels ne peuvent donc pas arriver."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications de cette app sont désactivées dans les Réglages iOS, les rappels ne peuvent donc pas arriver."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS सेटिंग्स में इस ऐप के नोटिफ़िकेशन बंद हैं, इसलिए रिमाइंडर नहीं आ सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi untuk app ini nonaktif di Pengaturan iOS, jadi pengingat tidak bisa sampai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche per questa app sono disattivate nelle Impostazioni di iOS, quindi i promemoria non possono arrivare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSの設定でこのアプリの通知がオフになっているため、リマインダーが届きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 설정에서 이 앱의 알림이 꺼져 있어 알림을 받을 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações deste app estão desativadas nos Ajustes do iOS, então os lembretes não podem chegar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления для этого приложения выключены в настройках iOS, поэтому напоминания не придут."
