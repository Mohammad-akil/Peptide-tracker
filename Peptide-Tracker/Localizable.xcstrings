    "It syncs a few seconds after each change you make, and you can sync any time here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم المزامنة بعد ثوانٍ من كل تغيير، ويمكنك المزامنة في أي وقت من هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert wird ein paar Sekunden nach jeder Änderung, und du kannst hier jederzeit synchronisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sincroniza unos segundos después de cada cambio, y puedes sincronizar cuando quieras aquí."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sincroniza unos segundos después de cada cambio, y puedes sincronizar cuando quieras aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation a lieu quelques secondes après chaque modification, et vous pouvez synchroniser à tout moment ici."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation a lieu quelques secondes après chaque modification, et vous pouvez synchroniser à tout moment ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर बदलाव के कुछ सेकंड बाद सिंक होता है, और आप यहाँ कभी भी सिंक कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersinkron beberapa detik setelah setiap perubahan, dan kamu bisa sinkron kapan saja di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
