        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо этого списываем по графику, а на экране «Сегодня» нет доз для отметки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun yerine planına göre geri sayarız ve Bugün işaretlenecek doz göstermez."
          }
