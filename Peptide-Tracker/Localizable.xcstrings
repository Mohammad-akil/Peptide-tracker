    "Pack injections in your hand luggage with a cool bag, and keep the prescription or a letter from your doctor with them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع الحقن في حقيبة اليد مع حقيبة تبريد، واحتفظ معها بالوصفة أو رسالة من طبيبك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pack Injektionen mit einer Kühltasche ins Handgepäck und hab das Rezept oder ein Schreiben deines Arztes dabei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva las inyecciones en el equipaje de mano con una bolsa isotérmica, junto con la receta o una carta de tu médico."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva las inyecciones en el equipaje de mano con una bolsa isotérmica, junto con la receta o una carta de tu médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez les injections en bagage cabine avec un sac isotherme, et gardez l’ordonnance ou une lettre de votre médecin avec."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez les injections en bagage cabine avec un sac isotherme, et gardez l’ordonnance ou une lettre de votre médecin avec."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंजेक्शन को कूल बैग में हैंड लगेज में रखें, और प्रिस्क्रिप्शन या डॉक्टर का पत्र साथ रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bawa obat suntik di kabin dengan tas pendingin, dan simpan resep atau surat dari dokter bersamanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti le iniezioni nel bagaglio a mano con una borsa frigo, insieme alla ricetta o a una lettera del medico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注射薬は保冷バッグに入れて機内持ち込みにし、処方箋か医師の手紙を一緒に持っておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주사제는 보냉 가방에 넣어 기내에 들고 타고, 처방전이나 의사 소견서를 함께 챙기세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve as injeções na bagagem de mão com uma bolsa térmica, junto com a receita ou uma carta do seu médico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевозите инъекции в ручной клади в термосумке, а рецепт или письмо врача держите при себе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjeksiyonları bir soğutucu çantayla el bagajına koy, reçeteyi veya doktorundan bir mektubu yanında tut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将注射药物放入保冷袋随身携带，并带上处方或医生证明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將注射藥物放入保冷袋隨身攜帶，並帶上處方或醫生證明。"
          }
        }
      }
    },
