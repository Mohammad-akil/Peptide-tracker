    "Once doses are due in the %@, you’ll see how you’re doing here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تستحق جرعات خلال %@، سترى هنا كيف تسير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald in den %@ Dosen fällig sind, siehst du hier, wie es läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando haya dosis previstas en los %@, verás aquí cómo vas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando haya dosis previstas en los %@, verás aquí cómo vas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que des doses seront prévues sur les %@, vous verrez ici où vous en êtes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que des doses seront prévues sur les %@, vous verrez ici où vous en êtes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जैसे ही %@ में खुराकें होंगी, आप यहाँ अपनी प्रगति देखेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah ada dosis terjadwal dalam %@, kamu akan melihat perkembanganmu di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ci saranno dosi previste negli %@, qui vedrai come stai andando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に服用予定があると、ここで状況を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 동안 복용이 예정되면 여기서 상황을 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando houver doses previstas nos %@, você verá aqui como está indo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда за %@ будут запланированы дозы, здесь появится прогресс."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ içinde planlı doz olduğunda nasıl gittiğini burada görürsün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦%@内有安排的剂量，你就能在这里看到进展。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦%@內有安排的劑量，你就能在這裡看到進展。"
          }
        }
      }
    },
    "Once every two weeks" : {
      "localizations" : {
        "ar" : {
