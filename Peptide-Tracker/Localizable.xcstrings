    "A personal log kept by the patient in %@. Not a medical record." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل شخصي يحتفظ به المريض في %@. ليس سجلاً طبياً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein persönliches Protokoll, vom Patienten in %@ geführt. Keine medizinische Akte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registro personal llevado por el paciente en %@. No es un historial médico."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registro personal llevado por el paciente en %@. No es un historial médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journal personnel tenu par le patient dans %@. Pas un dossier médical."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journal personnel tenu par le patient dans %@. Pas un dossier médical."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मरीज़ द्वारा %@ में रखा गया निजी लॉग। यह मेडिकल रिकॉर्ड नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan pribadi yang dibuat pasien di %@. Bukan rekam medis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diario personale tenuto dal paziente in %@. Non è una cartella clinica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "患者が%@で記録した個人用の記録です。診療記録ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "환자가 %@에서 작성한 개인 기록입니다. 의료 기록이 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registro pessoal mantido pelo paciente no %@. Não é prontuário médico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Личный журнал пациента в %@. Не является медицинской документацией."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastanın %@ içinde tuttuğu kişisel kayıt. Tıbbi kayıt değildir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "患者在 %@ 中记录的个人日志，并非医疗记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "患者在 %@ 中記錄的個人日誌，並非醫療記錄。"
          }
        }
      }
    },
    "A reminder timed to how long your refill really takes, so you never run out." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكير مضبوط على المدة الفعلية لإعادة الصرف، حتى لا ينفد دواؤك أبداً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Erinnerung, abgestimmt darauf, wie lange dein Nachschub wirklich dauert, damit dir nichts ausgeht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio ajustado a lo que de verdad tarda tu reposición, para que nunca te quedes sin él."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio ajustado a lo que de verdad tarda tu reposición, para que nunca te quedes sin él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel calé sur le vrai délai de votre renouvellement, pour ne jamais être à court."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
