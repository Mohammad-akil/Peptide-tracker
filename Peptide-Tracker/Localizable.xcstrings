    "Then it’s %@ %@. Cancel anytime in Settings before then if Pro isn’t for you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد ذلك %1$@ %2$@. ألغِ قبلها في أي وقت من الإعدادات إن لم يناسبك Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach %1$@ %2$@. Kündige vorher jederzeit in den Einstellungen, wenn Pro nichts für dich ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Then it’s %1$@ %2$@. Cancel anytime in Settings before then if Pro isn’t for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después son %1$@ %2$@. Cancela antes en Ajustes cuando quieras si Pro no es para ti."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después son %1$@ %2$@. Cancela antes en Configuración cuando quieras si Pro no es para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, c’est %1$@ %2$@. Résiliez avant dans Réglages si Pro ne vous convient pas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, c’est %1$@ %2$@. Résiliez avant dans Réglages si Pro ne vous convient pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर यह %1$@ %2$@ होगा। अगर Pro आपके लिए नहीं है तो उससे पहले सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah itu %1$@ %2$@. Batalkan kapan saja di Pengaturan sebelumnya jika Pro tidak cocok untukmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi costa %1$@ %2$@. Annulla prima in Impostazioni se Pro non fa per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その後は%1$@ %2$@。Proが合わなければ、それまでに設定でいつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 후에는 %1$@ %2$@입니다. Pro가 맞지 않으면 그 전에 설정에서 언제든 해지하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois são %1$@ %2$@. Cancele antes em Ajustes se o Pro não for para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затем %1$@ %2$@. Если Pro вам не подойдёт, отмените до этого в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonrasında %1$@ %2$@. Pro sana göre değilse o zamandan önce Ayarlar’dan istediğin zaman iptal et."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后为%1$@ %2$@。如果 Pro 不适合你，可在此之前随时在“设置”中取消。"
          }
