    "Choose a pace that matches your lifestyle and goals. It’s your call." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر وتيرة تناسب نمط حياتك وأهدافك. القرار لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Tempo, das zu deinem Alltag und deinen Zielen passt. Du entscheidest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un ritmo que encaje con tu estilo de vida y tus objetivos. Tú decides."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un ritmo que encaje con tu estilo de vida y tus objetivos. Tú decides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un rythme adapté à votre mode de vie et à vos objectifs. C’est vous qui décidez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un rythme adapté à votre mode de vie et à vos objectifs. C’est vous qui décidez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी जीवनशैली और लक्ष्य के हिसाब से रफ़्तार चुनें। फ़ैसला आपका है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih laju yang sesuai dengan gaya hidup dan tujuanmu. Kamu yang menentukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un ritmo adatto al tuo stile di vita e ai tuoi obiettivi. Decidi tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生活と目標に合ったペースを選んでください。決めるのはあなたです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생활 방식과 목표에 맞는 속도를 선택하세요. 결정은 당신의 몫입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um ritmo que combine com seu estilo de vida e seus objetivos. Você decide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите темп под свой образ жизни и цели. Решать вам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşam tarzına ve hedeflerine uyan bir tempo seç. Karar senin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择适合你的生活方式和目标的节奏。由你决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇適合你的生活方式和目標的節奏。由你決定。"
          }
        }
      }
    },
    "Choose all that apply. We’ll remind you of your why when you need it most." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر كل ما ينطبق. سنذكّرك بسببك عندما تحتاج إليه أكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle alles Zutreffende. Wir erinnern dich an dein Warum, wenn du es am meisten brauchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige todo lo que corresponda. Te recordaremos tu porqué cuando más lo necesites."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige todo lo que corresponda. Te recordaremos tu porqué cuando más lo necesites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez tout ce qui s’applique. Nous vous rappellerons pourquoi quand vous en aurez le plus besoin."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez tout ce qui s’applique. Nous vous rappellerons pourquoi quand vous en aurez le plus besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो भी लागू हो, सब चुनें। जब सबसे ज़्यादा ज़रूरत होगी, हम आपको आपकी वजह याद दिलाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih semua yang sesuai. Kami akan mengingatkan alasanmu saat paling dibutuhkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli tutto ciò che vale. Ti ricorderemo il tuo perché quando ne avrai più bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当てはまるものをすべて選んでください。いちばん必要なときに理由を思い出させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당하는 것을 모두 선택하세요. 가장 필요할 때 이유를 다시 떠올리게 해 드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha tudo o que se aplica. Vamos lembrar você do seu porquê quando mais precisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите всё подходящее. Мы напомним о вашей причине, когда это будет нужнее всего."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyanların hepsini seç. En çok ihtiyacın olduğunda nedenini hatırlatalım."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择所有适用项。在你最需要的时候，我们会提醒你初心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇所有適用項。在你最需要的時候，我們會提醒你初心。"
          }
        }
      }
