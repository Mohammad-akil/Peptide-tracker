            "value" : "Wir zählen ab hier herunter und warnen dich, bevor es ausgeht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contamos hacia atrás desde aquí y te avisamos antes de que se acabe."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contamos hacia atrás desde aquí y te avisamos antes de que se acabe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
