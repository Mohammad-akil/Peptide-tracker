          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서부터 카운트다운하고 떨어지기 전에 알려 드립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
