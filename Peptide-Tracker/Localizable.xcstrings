    "BMI is a general guide. It doesn’t account for muscle, age or body shape." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مؤشر كتلة الجسم دليل عام. لا يراعي العضلات أو العمر أو شكل الجسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der BMI ist ein grober Richtwert. Er berücksichtigt weder Muskeln, Alter noch Körperbau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El IMC es una guía general. No tiene en cuenta músculo, edad ni complexión."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El IMC es una guía general. No tiene en cuenta músculo, edad ni complexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IMC est un repère général. Il ne tient compte ni des muscles, ni de l’âge, ni de la morphologie."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IMC est un repère général. Il ne tient compte ni des muscles, ni de l’âge, ni de la morphologie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI एक सामान्य मार्गदर्शक है। यह मांसपेशी, उम्र या शरीर की बनावट नहीं देखता।"
