    "Enjoy a smoother experience, from managing side effects to hitting your weight loss milestones with less stress." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمتع بتجربة أسهل، من إدارة الآثار الجانبية إلى بلوغ مراحل فقدان الوزن بتوتر أقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genieße einen entspannteren Weg, vom Umgang mit Nebenwirkungen bis zum Erreichen deiner Abnehmziele."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disfruta de una experiencia más llevadera, desde gestionar efectos secundarios hasta alcanzar tus metas de pérdida de peso."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disfruta de una experiencia más llevadera, desde gestionar efectos secundarios hasta alcanzar tus metas de pérdida de peso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un parcours plus serein, de la gestion des effets secondaires à l’atteinte de vos étapes de perte de poids."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un parcours plus serein, de la gestion des effets secondaires à l’atteinte de vos étapes de perte de poids."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइड इफ़ेक्ट संभालने से लेकर वज़न घटाने के पड़ाव पाने तक, कम तनाव के साथ आसान अनुभव पाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikmati pengalaman yang lebih lancar, dari mengelola efek samping hingga mencapai target penurunan berat badan dengan lebih sedikit stres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivi un percorso più sereno, dalla gestione degli effetti collaterali al raggiungimento dei traguardi di peso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "副作用への対処から減量の目標達成まで、ストレスの少ない毎日を。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부작용 관리부터 감량 목표 달성까지, 스트레스는 줄이고 더 수월하게."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenha uma experiência mais tranquila, desde lidar com efeitos colaterais até alcançar suas metas de perda de peso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спокойнее на всём пути — от борьбы с побочными эффектами до этапов снижения веса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yan etkileri yönetmekten kilo verme hedeflerine ulaşmaya kadar daha az stresle daha rahat bir deneyim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从应对副作用到达成减重里程碑，体验更轻松、压力更少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從應對副作用到達成減重里程碑，體驗更輕鬆、壓力更少。"
          }
        }
      }
    },
