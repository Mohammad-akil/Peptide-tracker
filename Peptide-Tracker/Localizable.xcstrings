    "Preview of Doseday's Today screen with your doses and refills." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معاينة شاشة «اليوم» في Doseday مع جرعاتك وعمليات إعادة الصرف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschau des Doseday-Bildschirms „Heute“ mit deinen Dosen und Nachfüllungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa de la pantalla Hoy de Doseday con tus dosis y reposiciones."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa de la pantalla Hoy de Doseday con tus dosis y reposiciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu de l’écran Aujourd’hui de Doseday avec vos doses et renouvellements."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu de l’écran Aujourd’hui de Doseday avec vos doses et renouvellements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी खुराकों और रिफ़िल के साथ Doseday की आज स्क्रीन का प्रीव्यू।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratinjau layar Hari ini Doseday dengan dosis dan isi ulangmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima della schermata Oggi di Doseday con le tue dosi e i riordini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服用と補充が表示されたDosedayの「今日」画面のプレビュー。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복용과 보충이 표시된 Doseday 오늘 화면 미리 보기."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévia da tela Hoje do Doseday com suas doses e reposições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпросмотр экрана «Сегодня» Doseday с вашими дозами и пополнениями."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozların ve yenilemelerinle Doseday Bugün ekranının önizlemesi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doseday“今天”屏幕的预览，显示你的剂量和续药。"
          }
        },
