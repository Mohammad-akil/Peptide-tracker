    "Pick a plainer icon, like Graphite or Mono, so the Home Screen gives less away." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر أيقونة أبسط، مثل غرافيت أو أحادي، لتكشف الشاشة الرئيسية أقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein schlichteres Symbol wie Graphit oder Mono, damit der Home-Bildschirm weniger verrät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un icono más discreto, como Grafito o Mono, para que la pantalla de inicio revele menos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un icono más discreto, como Grafito o Mono, para que la pantalla de inicio revele menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une icône plus sobre, comme Graphite ou Mono, pour que l’écran d’accueil en dise moins."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une icône plus sobre, comme Graphite ou Mono, pour que l’écran d’accueil en dise moins."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रेफ़ाइट या मोनो जैसा सादा आइकन चुनें, ताकि होम स्क्रीन कम बताए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih ikon yang lebih polos, seperti Grafit atau Mono, agar Layar Utama tidak terlalu terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un’icona più sobria, come Grafite o Mono, così la Home rivela meno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラファイトやモノなど控えめなアイコンを選ぶと、ホーム画面から内容がわかりにくくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그래파이트나 모노처럼 수수한 아이콘을 고르면 홈 화면에서 덜 드러납니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um ícone mais discreto, como Grafite ou Mono, para a Tela de Início revelar menos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите более нейтральный значок, например «Графит» или «Моно», чтобы экран «Домой» выдавал меньше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafit veya Mono gibi sade bir simge seç, Ana Ekran daha az şey ele versin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择更朴素的图标，如“石墨”或“单色”，让主屏幕透露更少信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇更樸素的圖示，如「石墨」或「單色」，讓主畫面透露更少訊息。"
          }
        }
      }
    },
    "Pick how %@ looks on your Home Screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر كيف يبدو %@ على شاشتك الرئيسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie %@ auf deinem Home-Bildschirm aussieht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo se ve %@ en tu pantalla de inicio."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo se ve %@ en tu pantalla de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l’apparence de %@ sur votre écran d’accueil."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l’apparence de %@ sur votre écran d’accueil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि आपकी होम स्क्रीन पर %@ कैसा दिखे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tampilan %@ di Layar Utama."
          }
