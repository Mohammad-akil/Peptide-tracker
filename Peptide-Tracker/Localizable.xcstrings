    "Each injection you tick off counts as one needle. Counting starts when you turn this on or empty the container." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل حقنة تضع عليها علامة تُحسب إبرة واحدة. يبدأ العدّ عند تفعيل هذا الخيار أو تفريغ الحاوية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede abgehakte Injektion zählt als eine Kanüle. Die Zählung beginnt, wenn du dies einschaltest oder den Behälter leerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inyección marcada cuenta como una aguja. El recuento empieza al activar esto o vaciar el contenedor."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada inyección marcada cuenta como una aguja. El recuento empieza al activar esto o vaciar el contenedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque injection cochée compte pour une aiguille. Le décompte commence quand vous activez ceci ou videz le collecteur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque injection cochée compte pour une aiguille. Le décompte commence quand vous activez ceci ou videz le collecteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टिक किया हर इंजेक्शन एक सुई गिना जाता है। इसे चालू करने या कंटेनर खाली करने से गिनती शुरू होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap suntikan yang dicentang dihitung sebagai satu jarum. Penghitungan dimulai saat kamu mengaktifkan ini atau mengosongkan wadah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni iniezione spuntata conta come un ago. Il conteggio parte quando attivi questa opzione o svuoti il contenitore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックした注射1回を針1本として数えます。オンにしたときか容器を空にしたときから数え始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체크한 주사 1회를 바늘 1개로 셉니다. 이 기능을 켜거나 용기를 비울 때부터 셉니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada injeção marcada conta como uma agulha. A contagem começa quando você ativa isto ou esvazia o coletor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая отмеченная инъекция считается одной иглой. Подсчёт начинается при включении или опустошении контейнера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretlenen her enjeksiyon bir iğne sayılır. Sayım bunu açtığında veya kabı boşalttığında başlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次勾选注射计为一根针头。从开启此功能或清空容器时开始计数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次勾選注射計為一根針頭。從開啟此功能或清空容器時開始計數。"
          }
        }
      }
    },
