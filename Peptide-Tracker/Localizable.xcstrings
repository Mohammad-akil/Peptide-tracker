    "Reminders and widgets show each medicine’s name, even on the Lock Screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض التذكيرات والأدوات اسم كل دواء، حتى على شاشة القفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen und Widgets zeigen den Namen jedes Medikaments, auch auf dem Sperrbildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios y widgets muestran el nombre de cada medicamento, incluso en la pantalla bloqueada."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios y widgets muestran el nombre de cada medicamento, incluso en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels et widgets affichent le nom de chaque médicament, même sur l’écran verrouillé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels et widgets affichent le nom de chaque médicament, même sur l’écran verrouillé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिमाइंडर और विजेट हर दवा का नाम दिखाते हैं, लॉक स्क्रीन पर भी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat dan widget menampilkan nama setiap obat, bahkan di Layar Terkunci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria e widget mostrano il nome di ogni farmaco, anche sulla schermata di blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーとウィジェットに、ロック画面でも薬の名前を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림과 위젯에 잠금 화면에서도 각 약 이름이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembretes e widgets mostram o nome de cada remédio, mesmo na Tela Bloqueada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминания и виджеты показывают название каждого лекарства, даже на экране блокировки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatırlatmalar ve widget’lar her ilacın adını Kilitli Ekran’da bile gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒和小组件会显示每种药物的名称，锁定屏幕上也是如此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
