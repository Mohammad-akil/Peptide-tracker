    "Reminders are scheduled on the device. An exported medicine list goes only where you share it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجدول التذكيرات على الجهاز. قائمة الأدوية المصدّرة تذهب فقط حيث تشاركها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
