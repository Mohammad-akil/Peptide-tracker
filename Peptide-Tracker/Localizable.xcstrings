          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिमाइंडर डिवाइस पर तय होते हैं। एक्सपोर्ट की गई दवा सूची सिर्फ़ वहाँ जाती है जहाँ आप शेयर करते हैं।"
