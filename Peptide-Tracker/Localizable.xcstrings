      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توضيح: ترتفع الثقة أسرع خلال أول ثمانية أسابيع عند التعلّم مع Doseday مقارنة بالتعلّم وحدك."
          }
