    "Save your medicines, doses, weights, check-ins and side effects to your own iCloud, so they’re safe if you lose or change your phone and stay in sync on your iPhone and iPad." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ أدويتك وجرعاتك وأوزانك وتسجيلاتك اليومية والأعراض الجانبية في حساب iCloud الخاص بك، لتبقى آمنة إذا فقدت هاتفك أو غيّرته، ومتزامنة على iPhone وiPad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere deine Medikamente, Dosen, Gewichte, Check-ins und Nebenwirkungen in deiner eigenen iCloud – so bleiben sie erhalten, wenn du dein iPhone verlierst oder wechselst, und sind auf iPhone und iPad synchron."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus medicamentos, dosis, pesos, registros diarios y efectos secundarios en tu propio iCloud, para que estén a salvo si pierdes o cambias de teléfono y sincronizados en tu iPhone y iPad."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus medicamentos, dosis, pesos, registros diarios y efectos secundarios en tu propio iCloud, para que estén seguros si pierdes o cambias de celular y sincronizados en tu iPhone y iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez vos médicaments, doses, poids, bilans quotidiens et effets secondaires dans votre propre iCloud : ils restent en sécurité si vous perdez ou changez de téléphone, et synchronisés sur votre iPhone et votre iPad."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez vos médicaments, doses, poids, bilans quotidiens et effets secondaires dans votre propre iCloud : ils restent en sécurité si vous perdez ou changez de téléphone, et synchronisés sur votre iPhone et votre iPad."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी दवाएँ, खुराकें, वज़न, चेक-इन और साइड इफ़ेक्ट अपने iCloud में सेव करें, ताकि फ़ोन खोने या बदलने पर भी वे सुरक्षित रहें और आपके iPhone और iPad पर सिंक रहें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan obat, dosis, berat badan, check-in, dan efek samping ke iCloud Anda sendiri, agar tetap aman jika ponsel hilang atau diganti, dan tetap sinkron di iPhone dan iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva farmaci, dosi, pesi, check-in ed effetti collaterali nel tuo iCloud, così restano al sicuro se perdi o cambi telefono e sincronizzati su iPhone e iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お薬、投与記録、体重、チェックイン、副作用をあなた自身のiCloudに保存。iPhoneをなくしたり買い替えたりしても安心で、iPhoneとiPadで同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약, 투여 기록, 체중, 체크인, 부작용을 내 iCloud에 저장하세요. 휴대폰을 잃어버리거나 바꿔도 안전하고, iPhone과 iPad에서 동기화됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve seus medicamentos, doses, pesos, check-ins e efeitos colaterais no seu próprio iCloud, para que fiquem seguros se você perder ou trocar de celular e sincronizados no iPhone e iPad."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте лекарства, дозы, вес, отметки самочувствия и побочные эффекты в своём iCloud: данные не пропадут при потере или смене телефона и будут синхронизированы на iPhone и iPad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlaçlarını, dozlarını, kilonu, günlük kayıtlarını ve yan etkilerini kendi iCloud’una kaydet; telefonunu kaybetsen ya da değiştirsen de güvende kalsın, iPhone ve iPad’inde eşzamanlı olsun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的药物、剂量、体重、每日打卡和副作用保存到你自己的 iCloud，即使丢失或更换手机也不会丢失，并在 iPhone 和 iPad 上保持同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將你的藥物、劑量、體重、每日紀錄和副作用儲存到你自己的 iCloud，即使遺失或更換手機也不會遺失，並在 iPhone 和 iPad 上保持同步。"
          }
        }
      }
    },
