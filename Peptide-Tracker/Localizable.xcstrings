    "Every medicine, dose, refill, contact and setting is removed from this iPhone. You can’t undo this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف كل الأدوية والجرعات وعمليات إعادة الصرف وجهات الاتصال والإعدادات من هذا الـ iPhone. لا يمكن التراجع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Medikamente, Dosen, Nachfüllungen, Kontakte und Einstellungen werden von diesem iPhone entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan de este iPhone todos los medicamentos, dosis, reposiciones, contactos y ajustes. No se puede deshacer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan de este iPhone todos los medicamentos, dosis, reposiciones, contactos y ajustes. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les médicaments, doses, renouvellements, contacts et réglages sont supprimés de cet iPhone. Action irréversible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les médicaments, doses, renouvellements, contacts et réglages sont supprimés de cet iPhone. Action irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दवा, खुराक, रिफ़िल, संपर्क और सेटिंग इस iPhone से हटा दी जाती है। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua obat, dosis, isi ulang, kontak, dan pengaturan dihapus dari iPhone ini. Tidak bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni farmaco, dose, riordino, contatto e impostazione viene rimosso da questo iPhone. Non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
