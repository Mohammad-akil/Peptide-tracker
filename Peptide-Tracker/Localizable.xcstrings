    "Copy the “use within” time from the leaflet. You get a reminder the day before it’s due to be thrown away." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ مدة «يُستخدم خلال» من النشرة. ستصلك تذكرة قبل يوم من موعد التخلص منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übernimm die „Verwenden innerhalb“-Zeit aus dem Beipackzettel. Du wirst am Tag, bevor er entsorgt werden muss, erinnert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia el tiempo de «usar en» del prospecto. Recibirás un recordatorio el día antes de tener que desecharlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia el tiempo de «usar en» del prospecto. Recibirás un recordatorio el día antes de tener que desecharlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recopiez la durée « à utiliser dans » de la notice. Vous serez prévenu la veille du jour où il faut le jeter."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recopiez la durée « à utiliser dans » de la notice. Vous serez prévenu la veille du jour où il faut le jeter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पर्चे से \"इतने दिनों में इस्तेमाल करें\" की अवधि लिखें। फेंकने की तारीख़ से एक दिन पहले आपको रिमाइंडर मिलेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salin masa “gunakan dalam” dari brosur. Kamu akan diingatkan sehari sebelum harus dibuang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia il periodo “da usare entro” dal foglietto. Riceverai un promemoria il giorno prima di doverlo buttare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付文書の「開封後〇日以内に使用」の期間を入力してください。廃棄日の前日にお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설명서의 ‘개봉 후 사용 기간’을 입력하세요. 폐기해야 하는 날 하루 전에 알려 드립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie o prazo “usar em até” da bula. Você recebe um lembrete na véspera do dia de descartar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перепишите срок «использовать в течение» из инструкции. Напоминание придёт за день до утилизации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prospektüsteki “açıldıktan sonra kullanım” süresini gir. Atılması gereken günden bir gün önce hatırlatma alırsın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照抄说明书上的“开封后使用期限”。在需要丢弃的前一天会提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照抄說明書上的「開封後使用期限」。在需要丟棄的前一天會提醒你。"
          }
        }
      }
    },
