    "Severe, lasting or worrying side effects? Contact your doctor or pharmacist. In an emergency, call your local emergency number." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آثار جانبية شديدة أو مستمرة أو مقلقة؟ تواصل مع طبيبك أو الصيدلي. في حالة الطوارئ، اتصل برقم الطوارئ المحلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starke, anhaltende oder beunruhigende Nebenwirkungen? Wende dich an deinen Arzt oder Apotheker. Im Notfall ruf deine örtliche Notrufnummer an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Efectos secundarios graves, persistentes o preocupantes? Contacta con tu médico o farmacéutico. En una emergencia, llama al número de emergencias local."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Efectos secundarios graves, persistentes o preocupantes? Contacta con tu médico o farmacéutico. En una emergencia, llama al número de emergencias local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effets secondaires graves, persistants ou inquiétants ? Contactez votre médecin ou pharmacien. En cas d’urgence, appelez le numéro d’urgence local."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effets secondaires graves, persistants ou inquiétants ? Contactez votre médecin ou pharmacien. En cas d’urgence, appelez le numéro d’urgence local."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गंभीर, लंबे या चिंताजनक साइड इफ़ेक्ट? अपने डॉक्टर या फ़ार्मासिस्ट से संपर्क करें। आपात स्थिति में अपना स्थानीय आपात नंबर डायल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efek samping berat, berkepanjangan, atau mengkhawatirkan? Hubungi dokter atau apoteker. Dalam keadaan darurat, hubungi nomor darurat setempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effetti collaterali gravi, persistenti o preoccupanti? Contatta il medico o il farmacista. In caso di emergenza, chiama il numero di emergenza locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重い、長引く、または気になる副作用がありますか？ 医師または薬剤師に連絡してください。緊急時は地域の緊急番号に電話してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심하거나 오래가거나 걱정되는 부작용이 있나요? 의사나 약사에게 연락하세요. 응급 시 지역 응급 번호로 전화하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efeitos colaterais graves, persistentes ou preocupantes? Procure seu médico ou farmacêutico. Em uma emergência, ligue para o número de emergência local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильные, длительные или тревожные побочные эффекты? Обратитесь к врачу или фармацевту. В экстренной ситуации звоните по местному номеру экстренных служб."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şiddetli, uzun süren veya endişe verici yan etkiler mi? Doktoruna veya eczacına başvur. Acil durumda yerel acil numarasını ara."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出现严重、持续或令人担忧的副作用？请联系医生或药剂师。紧急情况下，请拨打当地急救电话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出現嚴重、持續或令人擔憂的副作用？請聯絡醫生或藥劑師。緊急情況下，請撥打當地急救電話。"
          }
        }
      }
    },
