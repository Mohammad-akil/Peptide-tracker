    "A notification at each dose time, only on the days each medicine is taken." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعار عند كل موعد جرعة، فقط في الأيام التي يؤخذ فيها كل دواء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Mitteilung zu jeder Einnahmezeit, nur an den Tagen, an denen das Medikament genommen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación en cada hora de toma, solo los días que se toma cada medicamento."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
