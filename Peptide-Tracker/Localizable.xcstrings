    "Counts the doses on your schedule for the trip, plus spare days in case of delays." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب جرعات جدولك خلال الرحلة، إضافة إلى أيام احتياطية تحسباً للتأخير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt die Dosen deines Plans für die Reise plus Reservetage für Verspätungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta las dosis previstas durante el viaje, más días de reserva por si hay retrasos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta las dosis previstas durante el viaje, más días de reserva por si hay retrasos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les doses prévues pendant le voyage, plus des jours de réserve en cas de retard."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les doses prévues pendant le voyage, plus des jours de réserve en cas de retard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रा के दौरान आपके शेड्यूल की खुराकें गिनता है, देरी के लिए अतिरिक्त दिन भी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghitung dosis sesuai jadwal selama perjalanan, ditambah hari cadangan jika ada keterlambatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta le dosi in programma durante il viaggio, più giorni di scorta in caso di ritardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行中の予定服用数に、遅延に備えた予備日分を加えて数えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행 기간 중 예정된 복용량에 지연을 대비한 여유일을 더해 계산합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta as doses do seu esquema durante a viagem, mais dias extras em caso de atrasos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считает дозы по графику на время поездки плюс запасные дни на случай задержек."
