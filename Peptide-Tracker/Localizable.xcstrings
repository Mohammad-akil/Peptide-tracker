    "Download every dose, medicine, refill, mood and weight as spreadsheets for Numbers, Excel or Google Sheets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نزّل كل جرعة ودواء وإعادة صرف ومزاج ووزن كجداول لـ Numbers أو Excel أو Google Sheets."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade alle Dosen, Medikamente, Nachfüllungen, Stimmungen und Gewichte als Tabellen für Numbers, Excel oder Google Sheets herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga cada dosis, medicamento, reposición, ánimo y peso como hojas de cálculo para Numbers, Excel o Google Sheets."
          }
