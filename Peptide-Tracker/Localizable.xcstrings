    "Nothing left to take today. You’re all caught up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يبقَ شيء لتتناوله اليوم. أنجزت كل شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute nichts mehr zu nehmen. Du bist auf dem neuesten Stand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No queda nada por tomar hoy. Estás al día."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No queda nada por tomar hoy. Estás al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus rien à prendre aujourd’hui. Vous êtes à jour."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus rien à prendre aujourd’hui. Vous êtes à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज लेने के लिए कुछ नहीं बचा। आप पूरी तरह अपडेट हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada lagi yang perlu diminum hari ini. Semua beres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente più da prendere oggi. Sei in pari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日飲むものはもうありません。すべて完了です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 더 복용할 것이 없습니다. 모두 마쳤어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada mais para tomar hoje. Tudo em dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сегодня принимать больше нечего. Всё под контролем."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün alınacak bir şey kalmadı. Her şey tamam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天没有要服用的了。你已全部完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天沒有要服用的了。你已全部完成。"
          }
        }
      }
    },
